# Copy to .env and fill in. Model ids must match GET {OMLX_BASE_URL}/models.
OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=
# Chat LLM for extraction, answers and judges: omlx | deepseek. Embeddings always use OMLX.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Required for omlx; defaults to deepseek-flash for deepseek
LLM_MODEL=
# Judge for `enigram eval` (Ragas + per-claim). Defaults to the generator above; a different
# model avoids a model grading its own answers. A reasoning judge spends max_tokens on reasoning.
JUDGE_PROVIDER=deepseek
JUDGE_MODEL=deepseek-v4-pro
JUDGE_MAX_TOKENS=8192
EMBED_MODEL=
EMBED_DIM=1024
EMBED_MAX_TOKENS=8192
TOKENIZER_PATH=~/.omlx/models/mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ
CHUNK_MAX_TOKENS=800
# 2 suits a local OMLX; an API provider such as DeepSeek can take more parallel calls
LLM_MAX_ASYNC=2
LLM_MAX_TOKENS=2048
MAX_PARALLEL_INSERT=2
# OMLX: template = chat_template_kwargs.enable_thinking=false | suffix = append /no_think | on = leave thinking on
# DeepSeek: template/suffix send thinking.type=disabled; on = leave thinking on
THINKING_MODE=template
DATA_DIR=./data
# Index storage: file (JSON/GraphML under DATA_DIR/rag_storage) | postgres (pgvector).
# Local Postgres: `docker compose up -d`. Parsed chunks, manifest and reports stay in DATA_DIR.
STORAGE_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=enigram
POSTGRES_PASSWORD=
POSTGRES_DATABASE=enigram
# Separates indexes in one database; `index --pages` uses <WORKSPACE>_dev. Not POSTGRES_WORKSPACE.
WORKSPACE=default
# Managed Postgres: require TLS
# POSTGRES_SSL_MODE=require
LOG_LEVEL=INFO
# API keys for `enigram api` (REST + MCP over HTTP), as name:key pairs: name is what query logs
# record. Empty = every route is open. Generate a key with `openssl rand -hex 24`.
ENIGRAM_API_KEYS=
# The key the web UI's nginx sends; must be one of ENIGRAM_API_KEYS (e.g. the `web:` one).
ENIGRAM_WEB_KEY=
# Publish the API port on the LAN (default 127.0.0.1). Only with ENIGRAM_API_KEYS set.
# API_BIND=0.0.0.0
# Hosts `POST /repos` may clone from (https only). Default: github.com,gitlab.com,bitbucket.org,codeberg.org
# REPO_HOSTS=
# Local Laya checkpoint used as the second judge by `enigram eval`
LAYA_PATH=~/.omlx/models/convaiinnovations/laya
