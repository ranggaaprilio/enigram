# Copy to .env and fill in. All models are online: DeepSeek (chat) and Voyage (embeddings).
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
# deepseek-flash (default) or deepseek-v4-pro
LLM_MODEL=deepseek-flash
# Judge for `enigram eval --judge` (Ragas + per-claim). A different model avoids a model grading
# its own answers. A reasoning judge spends max_tokens on reasoning.
JUDGE_PROVIDER=deepseek
JUDGE_MODEL=deepseek-v4-pro
JUDGE_MAX_TOKENS=8192
VOYAGE_API_KEY=
# Document embeddings (chunks, memories). Changing the model = reindex.
EMBED_MODEL=voyage-4-lite
EMBED_DIM=1024
EMBED_MAX_TOKENS=32000
CHUNK_MAX_TOKENS=800
LLM_MAX_ASYNC=4
LLM_MAX_TOKENS=2048
MAX_PARALLEL_INSERT=2
# off (default) sends thinking.type=disabled; on leaves DeepSeek's thinking on (slower, spends max_tokens)
THINKING_MODE=off
DATA_DIR=./data
# Bare clones the code agent reads source from; default DATA_DIR/repos.
# REPO_STORE=
# Index storage: file (JSON/GraphML under DATA_DIR/rag_storage) | postgres (pgvector).
# Local Postgres: `docker compose up -d`. Parsed chunks, manifest and reports stay in DATA_DIR.
STORAGE_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=enigram
POSTGRES_PASSWORD=
POSTGRES_DATABASE=enigram
# Separates indexes in one database; `index --pages` uses <WORKSPACE>_dev. Not POSTGRES_WORKSPACE.
WORKSPACE=default
# Managed Postgres: require TLS
# POSTGRES_SSL_MODE=require
LOG_LEVEL=INFO
# API keys for `enigram api` (REST + MCP over HTTP), as name:key pairs: name is what query logs
# record. Empty = every route is open. Generate a key with `openssl rand -hex 24`.
ENIGRAM_API_KEYS=
# The key the web UI's nginx sends; must be one of ENIGRAM_API_KEYS (e.g. the `web:` one).
ENIGRAM_WEB_KEY=
# Publish the API port on the LAN (default 127.0.0.1). Only with ENIGRAM_API_KEYS set.
# API_BIND=0.0.0.0
# Hosts `POST /repos` may clone from (https only). Default: github.com,gitlab.com,bitbucket.org,codeberg.org
# REPO_HOSTS=
# API key names (from ENIGRAM_API_KEYS) that may verify, reject or reassign any annotation; a note's
# owner always may. Comma list, e.g. web,laptop-a
# ANNOTATION_VERIFIERS=
# Worker checks indexed repositories for new commits (git ls-remote) every N seconds; 0 = off.
# REPO_POLL_SECS=120
# Token caps, counted from every DeepSeek call (0 = off). A worker job over MAX_TOKENS_PER_JOB
# stops with status budget_exceeded; when the workspace's DAILY_TOKEN_BUDGET (jobs and queries,
# UTC day) is used up, jobs stop and POST /repos, webhooks, /query and MCP answer 429; a key over
# PER_KEY_DAILY_TOKENS gets 429 on /query and MCP.
# MAX_TOKENS_PER_JOB=2000000
# DAILY_TOKEN_BUDGET=20000000
# PER_KEY_DAILY_TOKENS=2000000
# Sidecar location; default = <repo>/tools/ts-graph (/app/tools/ts-graph in Docker)
# TS_GRAPH_DIR=
