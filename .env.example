# Copy to .env. Only DEEPSEEK_API_KEY and VOYAGE_API_KEY are required for docker compose;
# everything else has a working default. All models are online: DeepSeek (chat), Voyage (embeddings).
DEEPSEEK_API_KEY=
# deepseek | openai-compatible (any /v1/chat/completions endpoint). Changing the chat model of an
# existing index = reindex.
LLM_PROVIDER=deepseek
# deepseek-flash (default) or deepseek-v4-pro
LLM_MODEL=deepseek-flash
# openai-compatible instead of DeepSeek: the model needs tool calling and JSON mode
# (`enigram doctor` checks both). Accuracy is measured on DeepSeek only.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the host; or https://api.openai.com/v1
# LLM_API_KEY=                                        # empty for a local server
# LLM_MODEL=
# Judge for `enigram eval --judge` (Ragas + per-claim). A different model avoids a model grading
# its own answers. A reasoning judge spends max_tokens on reasoning. JUDGE_PROVIDER empty = the
# generator's provider; with openai-compatible, JUDGE_BASE_URL and JUDGE_API_KEY default to the
# generator's.
JUDGE_PROVIDER=deepseek
JUDGE_MODEL=deepseek-v4-pro
JUDGE_MAX_TOKENS=8192
VOYAGE_API_KEY=
# Document embeddings (chunks, memories). Changing the model = reindex.
EMBED_MODEL=voyage-4-lite
EMBED_DIM=1024
EMBED_MAX_TOKENS=32000
# Code (flow summaries + symbols) for the semantic part of search_code; another dim needs the
# code_embeddings table dropped.
# CODE_EMBED_MODEL=voyage-code-4
# CODE_EMBED_DIM=1024
# voyage (default) | openai-compatible (any /v1/embeddings endpoint). For openai-compatible,
# VOYAGE_API_KEY is not needed but EMBED_MODEL, EMBED_DIM, CODE_EMBED_MODEL and CODE_EMBED_DIM
# must be set, and EMBED_MAX_TOKENS defaults to 8191. Changing either model = reindex.
# EMBED_PROVIDER=openai-compatible
# EMBED_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the host; or https://api.openai.com/v1
# EMBED_API_KEY=                                        # empty for a local server
# EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768
# CODE_EMBED_MODEL=nomic-embed-text
# CODE_EMBED_DIM=768
CHUNK_MAX_TOKENS=800
LLM_MAX_ASYNC=4
LLM_MAX_TOKENS=2048
MAX_PARALLEL_INSERT=2
# DeepSeek only. off (default) sends thinking.type=disabled; on leaves its thinking on (slower,
# spends max_tokens)
THINKING_MODE=off
DATA_DIR=./data
# Bare clones the code agent reads source from; default DATA_DIR/repos.
# REPO_STORE=
# Index storage: file (JSON/GraphML under DATA_DIR/rag_storage) | postgres (pgvector).
# Local Postgres: `docker compose up -d`. Parsed chunks, manifest and reports stay in DATA_DIR.
STORAGE_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=enigram
# The bundled Postgres listens on 127.0.0.1 only. Change this for a shared or managed database.
POSTGRES_PASSWORD=enigram
POSTGRES_DATABASE=enigram
# Separates indexes in one database; `index --pages` uses <WORKSPACE>_dev. Not POSTGRES_WORKSPACE.
WORKSPACE=default
# Managed Postgres: require TLS
# POSTGRES_SSL_MODE=require
LOG_LEVEL=INFO
# API keys for `enigram api` (REST + MCP over HTTP), as name:key pairs: name is what query logs
# record. Empty = every route is open. Generate a key with `openssl rand -hex 24`.
ENIGRAM_API_KEYS=
# The key the web UI's nginx sends; must be one of ENIGRAM_API_KEYS (e.g. the `web:` one).
# Leave it empty when people sign in (OIDC below).
ENIGRAM_WEB_KEY=
# Per-person sign-in for the web UI (OpenID Connect: Google, Microsoft Entra, Keycloak, ...).
# Register a web app at the provider with the redirect URL below. The first sign-in makes the
# person a viewer of WORKSPACE; admins raise roles on the Members page (docs/deployment.md "Sign-in").
# To try it locally: the `keycloak` compose profile (docs/deployment.md "Try it locally with Keycloak").
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://enigram.example.com/api/auth/callback
# Email domains that may sign in, comma list; `*` = every account of the issuer (a tenant).
# OIDC_ALLOWED_DOMAINS=example.com
# SESSION_DAYS=7
# The address people open the UI at, and publishing its port (only with sign-in):
# WEB_HOST=enigram.example.com
# WEB_ORIGIN=https://enigram.example.com
# WEB_BIND=0.0.0.0
# Publish the API port on the LAN (default 127.0.0.1). Only with ENIGRAM_API_KEYS set.
# API_BIND=0.0.0.0
# Hosts `POST /repos` may clone from (https only). Default: github.com,gitlab.com,bitbucket.org,codeberg.org
# REPO_HOSTS=
# Read once per key name, when a key of ENIGRAM_API_KEYS is first seen: a key listed here becomes
# `owner` (admin of every workspace), any other key `maintainer`. Roles are then managed with
# `uv run enigram principals` (docs/deployment.md "Roles", docs/rbac.md). Comma list, e.g. web
# ANNOTATION_VERIFIERS=
# Encrypts the access tokens of private repositories (Documents page "Access token", POST /repos
# "token"). Make one with `uv run enigram repo-key`. Without it only public repositories can be
# indexed; losing or changing it means adding each private repository again with its token.
# REPO_CREDENTIALS_KEY=
# Worker checks indexed repositories for new commits (git ls-remote) every N seconds; 0 = off.
# REPO_POLL_SECS=120
# Token caps, counted from every DeepSeek call (0 = off). A worker job over MAX_TOKENS_PER_JOB
# stops with status budget_exceeded; when the workspace's DAILY_TOKEN_BUDGET (jobs and queries,
# UTC day) is used up, jobs stop and POST /repos, webhooks, /query and MCP answer 429; a key over
# PER_KEY_DAILY_TOKENS gets 429 on /query and MCP.
# MAX_TOKENS_PER_JOB=2000000
# DAILY_TOKEN_BUDGET=20000000
# PER_KEY_DAILY_TOKENS=2000000
# Decision layer (abstain guard, note conflict detection, decision claim judge): jev = TypeSafe
# System One with the judge model as automatic fallback; llm_judge (default when empty) = the judge
# model only. jev sends question, evidence, code bodies, claims and notes to TypeSafe's API.
# DECISION_PROVIDER=jev
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai/v1
# Sidecar location; default = <repo>/tools/ts-graph (/app/tools/ts-graph in Docker)
# TS_GRAPH_DIR=
