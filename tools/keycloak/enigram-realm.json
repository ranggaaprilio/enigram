{
  "realm": "enigram",
  "displayName": "enigram (local)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "enigram-web",
      "name": "enigram web UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-secret-not-for-production",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback",
        "http://localhost:5173/api/auth/callback"
      ],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" }
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Viewer",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    },
    {
      "username": "eve",
      "email": "eve@other.test",
      "emailVerified": true,
      "firstName": "Eve",
      "lastName": "Outsider",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "eve", "temporary": false }]
    }
  ]
}
